def check_active_trades():

    closed = []

    for trade in active_trades:

        try:

            ticker = exchange.fetch_ticker(

                trade["symbol"]

            )

            price = ticker["last"]

            result = None

            if trade["direction"] == "LONG":

                if price >= trade["tp"]:

                    result = "WIN"

                elif price <= trade["sl"]:

                    result = "LOSS"

            else:

                if price <= trade["tp"]:

                    result = "WIN"

                elif price >= trade["sl"]:

                    result = "LOSS"

            if result:

                trade["result"] = result

                trade["close_time"] = datetime.utcnow(

                ).strftime("%Y-%m-%d %H:%M")

                trade_history.append(trade)

                stats["total"] += 1

                if result == "WIN":

                    stats["wins"] += 1

                else:

                    stats["losses"] += 1

                send_message(

                    f"""

📌 {trade['symbol']}

{trade['direction']}

{"✅ TAKE PROFIT HIT" if result=="WIN" else "❌ STOP LOSS HIT"}

"""

                )

                closed.append(trade)

        except:

            pass

    for c in closed:

        active_trades.remove(c)

