def get_ohlcv(symbol, timeframe="15m", limit=200):

    try:

        data = exchange.fetch_ohlcv(

            symbol,

            timeframe=timeframe,

            limit=limit

        )

        df = pd.DataFrame(data, columns=[

            "time",

            "open",

            "high",

            "low",

            "close",

            "volume"

        ])

        return df

    except:

        return None

# =========================================================

# 🧠 SMART MONEY ANALYSIS

# =========================================================

def analyze_symbol(symbol):

    confirmations = []

    confidence = 0

    try:

        # =================================================

        # MULTI TF DATA

        # =================================================

        df15 = get_ohlcv(symbol, "15m")

        df1h = get_ohlcv(symbol, "1h")

        df4h = get_ohlcv(symbol, "4h")

        if (

            df15 is None or

            df1h is None or

            df4h is None

        ):

            return None

        # =================================================

        # LIQUIDITY FILTER

        # =================================================

        ticker = exchange.fetch_ticker(symbol)

        volume = ticker["quoteVolume"]

        if volume < MIN_VOLUME_USDT:

            return None

        confirmations.append(

            f"✅ Ліквідність ${round(volume/1000000,1)}M"

        )

        confidence += 10

        # =================================================

        # EMA TREND

        # =================================================

        for df in [df15, df1h, df4h]:

            df["ema20"] = ta.trend.ema_indicator(

                df["close"],

                20

            )

            df["ema50"] = ta.trend.ema_indicator(

                df["close"],

                50

            )

        long_trend = (

            df15["ema20"].iloc[-1] >

            df15["ema50"].iloc[-1]

            and

            df1h["ema20"].iloc[-1] >

            df1h["ema50"].iloc[-1]

            and

            df4h["ema20"].iloc[-1] >

            df4h["ema50"].iloc[-1]

        )

        short_trend = (

            df15["ema20"].iloc[-1] <

            df15["ema50"].iloc[-1]

            and

            df1h["ema20"].iloc[-1] <

            df1h["ema50"].iloc[-1]

            and

            df4h["ema20"].iloc[-1] <

            df4h["ema50"].iloc[-1]

        )

        if not long_trend and not short_trend:

            return None

        direction = "LONG" if long_trend else "SHORT"

        confirmations.append(

            "✅ Multi-TF Trend"

        )

        confidence += 20

        # =================================================

        # RSI FILTER

        # =================================================

        df15["rsi"] = ta.momentum.rsi(

            df15["close"],

            14

        )

        rsi = df15["rsi"].iloc[-1]

        if direction == "LONG" and rsi > 72:

            return None

        if direction == "SHORT" and rsi < 28:

            return None

        confirmations.append(

            f"✅ RSI {round(rsi,1)}"

        )

        confidence += 10

        # =================================================

        # VOLUME SPIKE

        # =================================================

        avg_volume = df15["volume"].tail(20).mean()

        current_volume = df15["volume"].iloc[-1]

        volume_ratio = current_volume / avg_volume

        if volume_ratio < 2:

            return None

        confirmations.append(

            f"✅ Volume x{round(volume_ratio,1)}"

        )

        confidence += 15

        # =================================================

        # IMPULSE DETECTION

        # =================================================

        move = (

            (

                df15["close"].iloc[-1]

                -

                df15["close"].iloc[-5]

            )

            /

            df15["close"].iloc[-5]

        ) * 100

        if direction == "LONG":

            if move < 2:

                return None

        if direction == "SHORT":

            if move > -2:

                return None

        confirmations.append(

            "✅ Імпульс підтверджено"

        )

        confidence += 15

        # =================================================

        # NOT END OF MOVE

        # =================================================

        closes = df15["close"].tail(3).values

        if direction == "LONG":

            if closes[-1] < closes[-2]:

                return None

        if direction == "SHORT":

            if closes[-1] > closes[-2]:

                return None

        confirmations.append(

            "✅ НЕ кінець руху"

        )

        confidence += 12

        # =================================================

        # ATR TP/SL LOGIC

        # =================================================

        atr = ta.volatility.average_true_range(

            df15["high"],

            df15["low"],

            df15["close"],

            14

        ).iloc[-1]

        entry = df15["close"].iloc[-1]

        if direction == "LONG":

            sl = entry - (atr * ATR_SL_MULTIPLIER)

            tp = entry + (atr * ATR_TP_MULTIPLIER)

        else:

            sl = entry + (atr * ATR_SL_MULTIPLIER)

            tp = entry - (atr * ATR_TP_MULTIPLIER)

        tp_percent = abs(

            ((tp - entry) / entry) * 100

        )

        if tp_percent < MIN_TP_DISTANCE:

            return None

        if tp_percent > MAX_TP_DISTANCE:

            return None

        # =================================================

        # CONFIDENCE FILTER

        # =================================================

        if confidence < MIN_CONFIDENCE:

            return None

        # =================================================

        # ANTI SPAM

        # =================================================

        now = datetime.utcnow()

        if symbol in sent_signals:

            diff = now - sent_signals[symbol]

            if (

                diff.total_seconds()

                <

                ANTI_SPAM_MINUTES * 60

            ):

                return None

        sent_signals[symbol] = now

        # =================================================

        # ACTIVE TRADES LIMIT

        # =================================================

        if len(active_trades) >= MAX_ACTIVE_TRADES:

            return None

        # =================================================

        # SIGNAL OBJECT

        # =================================================

        signal = {

            "symbol": symbol,

            "direction": direction,

            "entry": round(entry, 6),

            "sl": round(sl, 6),

            "tp": round(tp, 6),

            "confidence": confidence,

            "confirmations": confirmations,

            "time": now.strftime(

                "%Y-%m-%d %H:%M"

            )

        }

        return signal

    except:

        return None

